# ==================================
# Backend API 환경 변수
# ==================================

# 서버 설정
NODE_ENV=development
PORT=3001

# 데이터베이스 설정
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/education_platform

# JWT 설정
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS 설정
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15분 (밀리초)
RATE_LIMIT_MAX_REQUESTS=100   # 윈도우당 최대 요청 수

# Stripe 결제 설정
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:3000/subscription/success
STRIPE_CANCEL_URL=http://localhost:3000/subscription/cancel

# 이메일 설정 (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=영어학습플랫폼 <no-reply@yourplatform.com>

# 관리자 이메일 (콤마로 구분)
ADMIN_EMAILS=admin@yourplatform.com,tech@yourplatform.com

# 프론트엔드 URL
FRONTEND_URL=http://localhost:3000

# 로깅 설정
ENABLE_FILE_LOGGING=true  # 파일 로깅 활성화 (프로덕션에서는 true 권장)

# AWS S3 파일 업로드 (선택사항 - 설정하지 않으면 로컬 저장소 사용)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_CLOUDFRONT_URL=https://your-cloudfront-domain.com  # CloudFront 사용 시 (선택사항)

# SendGrid 이메일 서비스 (선택사항 - 설정하지 않으면 Nodemailer 사용)
SENDGRID_API_KEY=your_sendgrid_api_key

# Redis (선택사항 - Socket.IO 수평 확장용)
REDIS_URL=redis://localhost:6379
