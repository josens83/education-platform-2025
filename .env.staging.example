# ============================================
# STAGING ENVIRONMENT CONFIGURATION
# ============================================

# Environment
NODE_ENV=staging

# ============================================
# Server Configuration
# ============================================
PORT=5000
FRONTEND_URL=https://staging.yourdomain.com
BACKEND_URL=https://api-staging.yourdomain.com

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:your_staging_password@staging-db-host:5432/education_platform_staging

# ============================================
# JWT & Authentication
# ============================================
JWT_SECRET=your-staging-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-staging-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=30d

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=https://staging.yourdomain.com

# ============================================
# Redis (Session & Caching)
# ============================================
REDIS_URL=redis://staging-redis-host:6379
REDIS_PASSWORD=your_staging_redis_password
REDIS_TLS=true

# ============================================
# Email Service (SendGrid)
# ============================================
SENDGRID_API_KEY=your_staging_sendgrid_api_key
EMAIL_FROM=noreply-staging@yourdomain.com
EMAIL_FROM_NAME=Education Platform (Staging)

# Email Service (Nodemailer - Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-staging-email@gmail.com
SMTP_PASS=your-staging-app-password

# ============================================
# AWS S3 (File Storage)
# ============================================
AWS_ACCESS_KEY_ID=your_staging_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_staging_aws_secret_access_key
AWS_S3_BUCKET=education-platform-staging
AWS_REGION=ap-northeast-2
AWS_CLOUDFRONT_URL=https://staging-cdn.yourdomain.com

# ============================================
# Stripe (Payment)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_staging_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_staging_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_staging_webhook_secret

# ============================================
# OAuth Providers
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=your-staging-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_staging_google_client_secret
GOOGLE_CALLBACK_URL=https://api-staging.yourdomain.com/api/auth/google/callback

# Kakao OAuth
KAKAO_CLIENT_ID=your_staging_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_staging_kakao_client_secret
KAKAO_CALLBACK_URL=https://api-staging.yourdomain.com/api/auth/kakao/callback

# ============================================
# OpenAI (AI Features)
# ============================================
OPENAI_API_KEY=sk-your-staging-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000

# ============================================
# Google Analytics
# ============================================
VITE_GA_MEASUREMENT_ID=G-STAGING123456

# ============================================
# Sentry (Error Tracking)
# ============================================
SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.5

# ============================================
# Session Configuration
# ============================================
SESSION_SECRET=your-staging-session-secret-change-this
SESSION_COOKIE_MAX_AGE=604800000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CSRF Protection
# ============================================
CSRF_SECRET=your-staging-csrf-secret-key-change-this

# ============================================
# Feature Flags
# ============================================
ENABLE_AI_TUTOR=true
ENABLE_SOCIAL_AUTH=true
ENABLE_2FA=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=true

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/staging

# ============================================
# Web Push Notifications (VAPID)
# ============================================
VAPID_PUBLIC_KEY=your_staging_vapid_public_key
VAPID_PRIVATE_KEY=your_staging_vapid_private_key
VAPID_SUBJECT=mailto:admin-staging@yourdomain.com

# ============================================
# Security Headers
# ============================================
HELMET_CSP_ENABLED=true
HELMET_HSTS_MAX_AGE=31536000

# ============================================
# Performance
# ============================================
CACHE_TTL_SECONDS=1800
MAX_FILE_UPLOAD_SIZE_MB=10
COMPRESSION_ENABLED=true

# ============================================
# Monitoring
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================
# Testing
# ============================================
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/education_platform_test
